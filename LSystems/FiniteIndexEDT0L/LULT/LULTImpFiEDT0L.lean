private lemma Language.isLULT_imp_isFiniteIndexEDT0L_fin {α} [Finite α] (L : Language α)
  (h : L.IsLULT) :
    L.IsFiniteIndexEDT0L := by
  classical
  obtain ⟨n,m,E,is_lult,rfl⟩ := h
  rw [← EDT0LGrammar.LULT2EDT0L.grammar_language_eq E is_lult]
  use n + 1
  have := Fintype.ofFinite α
  refine EDT0LGrammar.isIndex_imp_language_isEDT0LOfIndex
    (EDT0LGrammar.LULT2EDT0L.grammar E) (n + 1) ?_
  have : (EDT0LGrammar.LULT2EDT0L.grammar E).IsIndex (Fintype.card _ + 1) :=
    EDT0LGrammar.LULT2EDT0L.grammar_isFiniteIndex E
  simpa

lemma Language.isLULT_imp_isFiniteIndexEDT0L {α} (L : Language α) (h : L.IsLULT) :
    L.IsFiniteIndexEDT0L := by
  classical
  obtain ⟨n,m,E,is_lult,rfl⟩ := h
  rw [← EDT0LGrammar.attach_isLULT_iff] at is_lult
  have is_fi_edt0l := Language.isLULT_imp_isFiniteIndexEDT0L_fin E.attach.language
      ⟨_,_,_,is_lult,rfl⟩
  obtain ⟨k,⟨n',m',E',h',h''⟩⟩ := is_fi_edt0l
  have H := congrArg (Language.map Subtype.val) h''
  simp only [EDT0LGrammar.language_eq_attach_language_map_val] at H
  rw [← H]
  apply Language.map_isFiniteIndexEDT0L
  exact ⟨k,_,_,E',h',rfl⟩

